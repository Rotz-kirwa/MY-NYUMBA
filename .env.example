# PostgreSQL Production Database Connection
# Replace with your production PostgreSQL connection string (Neon, Supabase, AWS RDS, local Postgres, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mynyumba_prod

# Application Session Secret
SESSION_SECRET=mynyumba_default_super_secret_session_key_2026

# Server Port
PORT=8080

# M-Pesa Integration Credentials
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=MOCK_KEY
MPESA_CONSUMER_SECRET=MOCK_SECRET
MPESA_PASSKEY=MOCK_PASSKEY
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://mynyumba.co.ke/api/v1/mpesa/callback
